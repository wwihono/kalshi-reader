data/processed/**/*
!data/processed/**/.gitkeep

# Keep tracked sample fixtures if added later
!data/fixtures/**

# Logs / local outputs
*.log
outputs/
figures/
reports/*.html
reports/*.pdf
!reports/.gitkeep
